    <!-- Visiting the Playhouse -->
    <string name="visit.title">Visiting the Playhouse</string>
    <string name="android.visitBoxOffice">Box Office</string>
    <string name="visit.boxOffice1">107 S. Signal Street, directly behind the Playhouse and across from the Post Office and Libbey Park.</string>
    <string name="visit.boxOffice2">Opens 60 minutes before showtime. All tickets are held at will call and must be picked up at the box office before entering the Playhouse.</string>
    <string name="android.visitAbout">About the Playhouse</string>
    <string name="visit.about">Opened in 1914, the Ojai Playhouse is a historic 200-seat, single-screen movie theater at 145 E. Ojai Ave, next to Libbey Park. It screens digital and 35mm films, and curates music, comedy, variety and more.</string>
    <string name="android.visitParking">Parking</string>
    <string name="visit.parking1">On Ojai city streets, north and south of E. Ojai Avenue.</string>
    <string name="visit.parking2">ADA parking is on E. Ojai Avenue and S. Signal Street.</string>
    <string name="android.visitFood">Food &amp; Drink</string>
    <string name="visit.food">Popcorn, candy, fountain soda, beer &amp; wine, and specialty drinks.</string>
    <string name="android.visitAccess">Accessibility</string>
    <string name="visit.access">The Ojai Playhouse is ADA accessible.</string>
    <string name="android.visitSeating">Seating</string>
    <string name="visit.seating1">Movies are general admission.</string>
    <string name="visit.seating2">Music, comedy and other events may be general admission or reserved seating.</string>
    <string name="android.visitTickets">Tickets</string>
    <string name="visit.tickets">Sold on the Ojai Playhouse website. Prices vary by movie and event; see each one\'s details for pricing.</string>
    <string name="android.visitPolicies">Policies</string>
    <string name="visit.policy1">All sales are final. No refunds or exchanges.</string>
    <string name="visit.policy2">No late entry. Please arrive and be seated at least 15 minutes before the screening or performance.</string>
    <string name="visit.policy3">Phones must be off inside the theater during the movie or performance.</string>
    <string name="visit.policy4">No outside food, candy or drink.</string>
    <string name="visit.policy5">No smoking or vaping.</string>
    <string name="visit.policy6">Children 16 and under must be with an adult.</string>
    <string name="visit.policy7">The Ojai Playhouse reserves the right to refuse service to anyone.</string>
    <string name="android.visitGreen">Sustainability</string>
    <string name="visit.green">The Playhouse looks for green solutions across the theater\'s operations wherever it can.</string>
